# ──────────────────────────────────────────────────────────
#  BroadNet Website — Environment Variables
#  Copy this file to .env.local for local development
#  On Vercel: add these in Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────

# Admin email — enquiry submissions are delivered here
ADMIN_EMAIL=admin@broadnet.in

# SMTP Configuration (required for the enquiry form to send emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@broadnet.in
SMTP_PASS=your_email_password
